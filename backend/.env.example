# ── Application ──────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=videogen
DB_PASSWORD=secret
DB_DATABASE=videogen

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRATION=7d

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── ElevenLabs ───────────────────────────────────────
ELEVENLABS_API_KEY=xi-...
ELEVENLABS_VOICE_ID=default-voice-id

# ── Fal.ai ───────────────────────────────────────────
FAL_API_KEY=fal-...

# ── Storage ──────────────────────────────────────────
UPLOAD_DIR=./uploads
